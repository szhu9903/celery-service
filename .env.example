# ==============================================================================
# .env.example
# Copy to .env and fill in values for local development.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# In production, inject via Docker secrets / K8s Secrets / Vault.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development         # development | staging | production | test
SERVICE_NAME=celery-service
SERVICE_VERSION=1.0.0

# ── Broker ────────────────────────────────────────────────────────────────────
# Redis (default)
BROKER_URL=redis://localhost:6379/0
# RabbitMQ alternative:
# BROKER_URL=amqp://celery:celery_pass@localhost:5672/
# Redis Sentinel:
# BROKER_URL=sentinel://sentinel1:26379/0
# BROKER_SENTINEL_MASTER=mymaster

BROKER_POOL_MAX_CONNECTIONS=20
BROKER_SOCKET_TIMEOUT=5.0
BROKER_SOCKET_CONNECT_TIMEOUT=5.0

# ── Result Backend ────────────────────────────────────────────────────────────
BACKEND_URL=redis://localhost:6379/1
BACKEND_RESULT_EXPIRES=3600        # seconds
BACKEND_RESULT_COMPRESSION=gzip    # gzip | bzip2 | zlib | (empty = off)

# ── Worker Tuning ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4               # number of parallel processes
WORKER_POOL=prefork                # prefork | eventlet | gevent | solo
WORKER_MAX_TASKS_PER_CHILD=500     # restart process after N tasks (memory leak guard)
WORKER_MAX_MEMORY_PER_CHILD=200000 # restart if RSS exceeds N KB (200 MB)
WORKER_PREFETCH_MULTIPLIER=1       # 1 = one task per process at a time (fairest)
WORKER_TASK_ACKS_LATE=true
WORKER_TASK_REJECT_ON_WORKER_LOST=true
WORKER_HEARTBEAT_INTERVAL=10.0
WORKER_SHUTDOWN_TIMEOUT=60         # graceful drain timeout (seconds)

# ── Queues ────────────────────────────────────────────────────────────────────
QUEUE_QUEUES=default,high,low,critical
QUEUE_DEFAULT_QUEUE=default
QUEUE_DEAD_LETTER_QUEUE=dlq

# ── Observability ─────────────────────────────────────────────────────────────
OBS_LOG_LEVEL=DEBUG                # DEBUG in dev, INFO in prod
OBS_LOG_FORMAT=console             # console in dev, json in prod

OBS_PROMETHEUS_ENABLED=true
OBS_PROMETHEUS_PORT=9090

OBS_OTEL_ENABLED=false
OBS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OBS_OTEL_SERVICE_NAME=celery-service

OBS_SENTRY_DSN=                    # leave blank to disable
OBS_SENTRY_ENVIRONMENT=development
OBS_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Security ──────────────────────────────────────────────────────────────────
SECURITY_TASK_SERIALIZER=json      # json | msgpack  (never pickle)
# Generate with: make secret
SECRET_KEY=CHANGE_ME_use_make_secret_to_generate
